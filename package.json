{
  "name": "ai-anti-bullying-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:gh": "VITE_BASE=/anti-bulling/ tsc && VITE_BASE=/anti-bulling/ vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "deploy:cf": "npm run build && wrangler pages deploy dist --project-name=antibulling --branch=main"
  },
  "dependencies": {
    "@lit-labs/router": "^0.1.4",
    "@shortfuse/materialdesignweb": "^0.11.4",
    "idb": "^8.0.3",
    "lit": "^3.3.3",
    "motion": "^13.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
